<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>THE NEIGHBOUR - Mansion Escape</title>

<style>
*{box-sizing:border-box}

body{
    margin:0;
    background:#090909;
    color:white;
    font-family:Arial,sans-serif;
    overflow:hidden;
}

#game{
    width:100vw;
    height:100vh;
    position:relative;
    background:#171717;
}

/* MANSION */

#mansion{
    width:1000px;
    height:650px;
    position:absolute;
    left:50%;
    top:50%;
    transform:translate(-50%,-50%);
    background:#29241f;
    border:12px solid #111;
    box-shadow:0 0 50px #000;
}

.room{
    position:absolute;
    border:5px solid #51483e;
    background:#312b25;
}

.room h3{
    margin:10px;
    color:#a99b89;
    font-size:15px;
}

#living{
    left:0;
    top:0;
    width:330px;
    height:320px;
}

#bedroom{
    left:330px;
    top:0;
    width:335px;
    height:320px;
}

#study{
    right:0;
    top:0;
    width:335px;
    height:320px;
}

#kitchen{
    left:0;
    bottom:0;
    width:330px;
    height:330px;
}

#hall{
    left:330px;
    bottom:0;
    width:335px;
    height:330px;
}

#basement{
    right:0;
    bottom:0;
    width:335px;
    height:330px;
}

/* PLAYER */

#player{
    position:absolute;
    width:25px;
    height:25px;
    background:#f5f5f5;
    border-radius:50%;
    box-shadow:0 0 15px white;
    z-index:20;
}

/* NEIGHBOUR */

#neighbour{
    position:absolute;
    width:34px;
    height:34px;
    background:#741313;
    border-radius:50%;
    box-shadow:0 0 18px red;
    z-index:19;
}

/* ITEMS */

.item{
    position:absolute;
    font-size:30px;
    z-index:15;
    cursor:pointer;
    user-select:none;
}

.key1{left:250px;top:250px}
.key2{left:570px;top:180px}
.key3{left:850px;top:530px}

.battery{left:110px;top:470px}

.picture{
    position:absolute;
    font-size:45px;
    z-index:10;
}

.pic1{left:100px;top:80px}
.pic2{left:450px;top:70px}
.pic3{left:760px;top:80px}

/* LOCKED DOORS */

.locked{
    position:absolute;
    font-size:28px;
    z-index:12;
}

.door1{left:310px;top:135px}
.door2{left:645px;top:400px}
.door3{left:470px;top:300px}

/* UI */

#ui{
    position:fixed;
    top:15px;
    left:15px;
    background:rgba(0,0,0,.85);
    padding:14px;
    border-radius:10px;
    z-index:200;
    line-height:1.7;
}

#message{
    position:fixed;
    bottom:20px;
    left:50%;
    transform:translateX(-50%);
    background:rgba(0,0,0,.9);
    padding:14px 25px;
    border-radius:10px;
    z-index:200;
    text-align:center;
}

/* CONTROLS */

#controls{
    position:fixed;
    bottom:20px;
    right:20px;
    background:rgba(0,0,0,.7);
    padding:12px;
    border-radius:10px;
    z-index:200;
    font-size:13px;
}

/* FLASHLIGHT */

#flashlight{
    position:fixed;
    inset:0;
    pointer-events:none;
    z-index:100;
    background:radial-gradient(
        circle 190px at 50% 50%,
        transparent 0,
        rgba(0,0,0,.15) 45%,
        rgba(0,0,0,.75) 75%
    );
}

/* START */

#start{
    position:fixed;
    inset:0;
    background:#050505;
    z-index:1000;
    display:flex;
    align-items:center;
    justify-content:center;
    flex-direction:column;
    text-align:center;
}

#start h1{
    font-size:55px;
    color:#a00000;
    text-shadow:0 0 25px red;
}

button{
    padding:15px 35px;
    background:#222;
    border:2px solid #900;
    color:white;
    border-radius:10px;
    font-size:20px;
    cursor:pointer;
}

button:hover{
    background:#900;
}

/* JUMPSCARE */

#jumpscare{
    position:fixed;
    inset:0;
    background:#000;
    z-index:5000;
    display:none;
    justify-content:center;
    align-items:center;
    flex-direction:column;
}

#face{
    font-size:190px;
    animation:shake .06s infinite;
}

#jumpscare h1{
    color:red;
    font-size:42px;
}

@keyframes shake{
    0%{transform:translate(8px,8px)}
    25%{transform:translate(-8px,-8px)}
    50%{transform:translate(8px,-8px)}
    75%{transform:translate(-8px,8px)}
    100%{transform:translate(0)}
}

/* WIN */

#win{
    position:fixed;
    inset:0;
    background:#050505;
    z-index:4000;
    display:none;
    align-items:center;
    justify-content:center;
    flex-direction:column;
}

#win h1{
    color:#4cff4c;
    font-size:55px;
}
</style>
</head>

<body>

<!-- START SCREEN -->

<div id="start">

<h1>🏚️ THE NEIGHBOUR</h1>

<p>You are trapped inside an abandoned mansion.</p>

<p>Find the keys. Unlock the rooms. Escape.</p>

<p>But whatever you do...</p>

<h2>👁️ DON'T LET THE NEIGHBOUR SEE YOU.</h2>

<button onclick="startGame()">START GAME</button>

</div>


<!-- GAME -->

<div id="game">

<div id="ui">
❤️ Lives: <span id="lives">3</span><br>
🔑 Keys: <span id="keys">0</span>/3<br>
🔦 Battery: <span id="battery">100</span>%<br>
👁️ Status: <span id="status">SAFE</span>
</div>

<div id="mansion">

<div id="living" class="room">
<h3>LIVING ROOM</h3>
</div>

<div id="bedroom" class="room">
<h3>BEDROOM 🔒</h3>
</div>

<div id="study" class="room">
<h3>STUDY 🔒</h3>
</div>

<div id="kitchen" class="room">
<h3>KITCHEN</h3>
</div>

<div id="hall" class="room">
<h3>HALLWAY 🚪</h3>
</div>

<div id="basement" class="room">
<h3>BASEMENT 🔒</h3>
</div>


<!-- PHOTO FRAMES -->

<div class="picture pic1">🖼️</div>
<div class="picture pic2">🖼️</div>
<div class="picture pic3">🖼️</div>


<!-- ITEMS -->

<div id="key1" class="item key1" onclick="collectKey(1)">🔑</div>
<div id="key2" class="item key2" onclick="collectKey(2)">🔑</div>
<div id="key3" class="item key3" onclick="collectKey(3)">🔑</div>

<div id="batteryItem" class="item battery" onclick="collectBattery()">🔋</div>


<!-- LOCKED DOORS -->

<div class="locked door1" onclick="door(1)">🔒</div>
<div class="locked door2" onclick="door(2)">🔒</div>
<div class="locked door3" onclick="door(3)">🔒</div>


<!-- PLAYER -->

<div id="player"></div>

<!-- NEIGHBOUR -->

<div id="neighbour"></div>

</div>

<div id="flashlight"></div>

<div id="message">
Find the first key...
</div>

<div id="controls">
<b>CONTROLS</b><br>
W A S D = Walk<br>
SHIFT = Run<br>
C = Crouch<br>
SPACE = Jump<br>
E = Interact / Hide<br>
F = Flashlight
</div>

</div>


<!-- JUMPSCARE -->

<div id="jumpscare">

<div id="face">👹</div>

<h1>THE NEIGHBOUR CAUGHT YOU!</h1>

<p>YOU SHOULD HAVE HIDDEN...</p>

<button onclick="location.reload()">TRY AGAIN</button>

</div>


<!-- WIN -->

<div id="win">

<h1>🎉 YOU ESCAPED!</h1>

<p>You survived the mansion.</p>

<p>The Neighbour couldn't catch you.</p>

<button onclick="location.reload()">PLAY AGAIN</button>

</div>


<script>

let playing=false;

let lives=3;
let keys=0;
let battery=100;

let crouching=false;
let hidden=false;
let flashlightOn=true;

let playerX=80;
let playerY=120;

let neighbourX=820;
let neighbourY=520;

let chasing=false;
let tired=0;

const player=document.getElementById("player");
const neighbour=document.getElementById("neighbour");

const message=document.getElementById("message");
const statusText=document.getElementById("status");


/* START */

function startGame(){

document.getElementById("start").style.display="none";

playing=true;

updatePlayer();
updateNeighbour();

message.textContent="Find the keys... and stay quiet.";

}


/* PLAYER */

document.addEventListener("keydown",function(e){

if(!playing)return;

let speed=5;

if(e.shiftKey && !crouching){
speed=9;
}

if(crouching){
speed=2.5;
}

if(e.key.toLowerCase()==="w"){
playerY-=speed;
}

if(e.key.toLowerCase()==="s"){
playerY+=speed;
}

if(e.key.toLowerCase()==="a"){
playerX-=speed;
}

if(e.key.toLowerCase()==="d"){
playerX+=speed;
}


/* CROUCH */

if(e.key.toLowerCase()==="c"){

crouching=!crouching;

if(crouching){
player.style.transform="scale(.7)";
message.textContent="🤫 You're crouching.";
}else{
player.style.transform="scale(1)";
message.textContent="You're standing.";
}

}


/* FLASHLIGHT */

if(e.key.toLowerCase()==="f"){

flashlightOn=!flashlightOn;

document.getElementById("flashlight").style.display=
flashlightOn?"block":"none";

}


/* INTERACT / HIDE */

if(e.key.toLowerCase()==="e"){

hidden=!hidden;

if(hidden){

message.textContent="🫣 You are hiding...";

player.style.opacity="0";

}else{

message.textContent="You came out of hiding.";

player.style.opacity="1";

}

}


/* JUMP */

if(e.code==="Space"){

player.style.transform="translateY(-35px)";

setTimeout(()=>{

player.style.transform=crouching?"scale(.7)":"scale(1)";

},250);

}


playerX=Math.max(10,Math.min(960,playerX));
playerY=Math.max(10,Math.min(610,playerY));

updatePlayer();

});


function updatePlayer(){

player.style.left=playerX+"px";
player.style.top=playerY+"px";

}


/* NEIGHBOUR AI */

setInterval(function(){

if(!playing)return;

if(hidden)return;

let dx=playerX-neighbourX;
let dy=playerY-neighbourY;

let distance=Math.sqrt(dx*dx+dy*dy);


/* VISION */

if(distance<230 && !crouching){

chasing=true;
tired=0;

statusText.textContent="🚨 SEEN!";

statusText.style.color="red";

message.textContent="👁️ THE NEIGHBOUR SAW YOU! RUN!";

}else if(distance>330){

if(chasing){

tired++;

if(tired>80){

chasing=false;

statusText.textContent="SAFE";

statusText.style.color="white";

message.textContent="The Neighbour lost you...";

}

}

}


/* CHASE */

if(chasing){

let speed=crouching?1.2:2.2;

neighbourX+=dx/distance*speed;
neighbourY+=dy/distance*speed;

}else{

/* PATROL */

neighbourX+=Math.sin(Date.now()/1000)*.5;
neighbourY+=Math.cos(Date.now()/1000)*.5;

}


/* CAUGHT */

if(distance<35){

caught();

}


updateNeighbour();

},50);


function updateNeighbour(){

neighbour.style.left=neighbourX+"px";
neighbour.style.top=neighbourY+"px";

}


/* KEYS */

function collectKey(number){

if(!playing)return;

let item=document.getElementById("key"+number);

if(item.style.display==="none")return;

item.style.display="none";

keys++;

document.getElementById("keys").textContent=keys;

message.textContent="🔑 KEY COLLECTED!";

playBeep();

if(keys===3){

message.textContent=
"🔓 All keys collected! Find the exit.";

}

}


/* BATTERY */

function collectBattery(){

battery=100;

document.getElementById("battery").textContent=battery;

document.getElementById("batteryItem").style.display="none";

message.textContent="🔋 Flashlight recharged!";

playBeep();

}


/* DOORS */

function door(number){

if(keys>=number){

message.textContent=
"🔓 Room "+number+" unlocked!";

}else{

message.textContent=
"🔒 Locked. You need more keys.";

}

}


/* PHOTO FRAMES */

document.querySelectorAll(".picture").forEach(function(pic){

pic.addEventListener("click",function(){

message.textContent=
"🖼️ An old family photograph...";

if(Math.random()<0.25){

jumpscare();

}

});

});


/* CAUGHT */

function caught(){

lives--;

document.getElementById("lives").textContent=lives;

if(lives<=0){

jumpscare();

}else{

playerX=80;
playerY=120;

neighbourX=850;
neighbourY=520;

chasing=false;

message.textContent=
"😱 You were caught! You escaped just in time.";

}

}


/* JUMPSCARE */

function jumpscare(){

playing=false;

document.getElementById("jumpscare").style.display="flex";

scarySound();

}


/* WIN */

document.getElementById("hall").addEventListener("click",function(){

if(keys===3){

playing=false;

document.getElementById("win").style.display="flex";

}else{

message.textContent=
"🚪 The exit is locked. Find all 3 keys!";

}

});


/* BATTERY */

setInterval(function(){

if(!playing)return;

if(flashlightOn){

battery--;

document.getElementById("battery").textContent=battery;

if(battery<=0){

flashlightOn=false;

document.getElementById("flashlight").style.display="none";

message.textContent=
"🔦 Your flashlight died!";

}

}

},1000);


/* SOUNDS */

function playBeep(){

let audioCtx=
new(window.AudioContext||window.webkitAudioContext)();

let oscillator=audioCtx.createOscillator();

let gain=audioCtx.createGain();

oscillator.connect(gain);
gain.connect(audioCtx.destination);

oscillator.frequency.value=700;

gain.gain.value=.12;

oscillator.start();

oscillator.stop(audioCtx.currentTime+.15);

}


function scarySound(){

let audioCtx=
new(window.AudioContext||window.webkitAudioContext)();

let oscillator=audioCtx.createOscillator();

let gain=audioCtx.createGain();

oscillator.connect(gain);
gain.connect(audioCtx.destination);

oscillator.type="sawtooth";

oscillator.frequency.setValueAtTime(
180,
audioCtx.currentTime
);

oscillator.frequency.exponentialRampToValueAtTime(
45,
audioCtx.currentTime+1
);

gain.gain.setValueAtTime(
.3,
audioCtx.currentTime
);

gain.gain.exponentialRampToValueAtTime(
.01,
audioCtx.currentTime+1
);

oscillator.start();

oscillator.stop(audioCtx.currentTime+1);

}

</script>

</body>
</html>
